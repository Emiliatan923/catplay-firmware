--- a/kver_compat.h
+++ b/kver_compat.h
@@ -37,3 +37,21 @@
 #else
 #include <asm/unaligned.h>
 #endif
+
+/*
+ * struct usb_gadget_ops gained func_wakeup() and struct usb_function gained
+ * func_wakeup_armed in Linux 6.6, together with USB_INTRF_FUNC_SUSPEND_RW and
+ * usb_func_wakeup(). The Rockchip 6.1 vendor kernel used by the ROCK 2A port
+ * predates all of them, so the function-suspend remote-wakeup path simply does
+ * not exist there.
+ *
+ * On older kernels usb_func_wakeup() always fails, which is exactly what the
+ * 6.6 implementation returns when the UDC has no func_wakeup op, and the
+ * "armed" bookkeeping has nowhere to be stored. Compile that path out rather
+ * than faking a field the kernel does not have.
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+#define IPHONE_HAVE_FUNC_WAKEUP 1
+#else
+#define IPHONE_HAVE_FUNC_WAKEUP 0
+#endif
--- a/Makefile
+++ b/Makefile
@@ -4,13 +4,29 @@
 
 g_iphone-y := iphone_mod.o iphone_dev.o iphone_class.o f_iphone.o g_iphone_impl.o composite.o 
 
+# KDIR may be supplied by an out-of-tree build system (Yocto's module class
+# exports KERNEL_SRC and O). Falling back to the running kernel's build tree
+# keeps the original hand-build workflow working.
+KDIR ?= $(KERNEL_SRC)
+ifeq ($(KDIR),)
 KDIR := /lib/modules/$(shell uname -r)/build
+endif
 
 PWD := $(shell pwd)
 
 all:
 	$(MAKE) -C $(KDIR) M=$(PWD) modules
 
+# Yocto's module class drives `modules` and `modules_install` directly, so
+# provide them. `modules` is what `all` already does; `modules_install` needs
+# the same MODLIB the class passes so the .ko files land where the
+# kernel-module-* packaging split expects them.
+modules:
+	$(MAKE) -C $(KDIR) M=$(PWD) modules
+
+modules_install:
+	$(MAKE) -C $(KDIR) M=$(PWD) modules_install
+
 clean:
 	$(MAKE) -C $(KDIR) M=$(PWD) clean
 
