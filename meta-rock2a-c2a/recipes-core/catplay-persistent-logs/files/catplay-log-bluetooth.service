[Unit]
Description=Persist Bluetooth messages for the current boot
Requires=catplay-log-setup.service
After=catplay-log-setup.service systemd-journald.service
Before=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/journalctl --boot=0 --unit=bluetooth.service --follow --no-pager --output=short-monotonic
StandardOutput=append:/run/catplay-logs/current/bluetooth.log
StandardError=append:/run/catplay-logs/current/bluetooth.log
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target

