Subject: [PATCH] usb: core: use 1ms reset waits for fast-enum ports
Upstream-Status: Pending

The DWC2 root-hub SetPortFeature(RESET) implementation holds reset for 50ms
and clears it synchronously before returning.  Waiting another 60ms before
the first status read, then 200ms before every retry, only delays discovery
of a port-enable interrupt which has already fired.

For USB_PORT_QUIRK_FAST_ENUM ports, read the status 1ms after the synchronous
reset operation and retain that short delay for reset retries.  Keep the
conservative long delay for devices already known to be low speed.

---
 drivers/usb/core/hub.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)
--- a/drivers/usb/core/hub.c
+++ b/drivers/usb/core/hub.c
@@ -2913,6 +2913,7 @@ static enum usb_device_speed port_speed(struct usb_hub *hub, u16 portstatus)
 #define DETECT_DISCONNECT_TRIES 5
 
 #define HUB_ROOT_RESET_TIME	60	/* times are in msec */
+#define HUB_FAST_RESET_TIME	1
 #define HUB_SHORT_RESET_TIME	10
 #define HUB_BH_RESET_TIME	50
 #define HUB_LONG_RESET_TIME	200
@@ -3166,7 +3167,10 @@ static int hub_port_reset(struct usb_hub *hub, int port1,
 		dev_dbg(&port_dev->dev,
 				"not enabled, trying %sreset again...\n",
 				warm ? "warm " : "");
-		delay = HUB_LONG_RESET_TIME;
+		if (port_dev->quirks & USB_PORT_QUIRK_FAST_ENUM)
+			delay = HUB_FAST_RESET_TIME;
+		else
+			delay = HUB_LONG_RESET_TIME;
 	}
 
 	dev_err(&port_dev->dev, "Cannot enable. Maybe the USB cable is bad?\n");
@@ -4956,6 +4961,8 @@ hub_port_init(struct usb_hub *hub, struct usb_device *udev, int port1,
 	/*  be a bit pessimistic with those devices. RHbug #23670 */
 	if (oldspeed == USB_SPEED_LOW)
 		delay = HUB_LONG_RESET_TIME;
+	else if (port_dev->quirks & USB_PORT_QUIRK_FAST_ENUM)
+		delay = HUB_FAST_RESET_TIME;
 
 	/* Reset the device; full speed may morph to high speed */
 	/* FIXME a USB 2.0 device may morph into SuperSpeed on reset. */
-- 
2.55.0
